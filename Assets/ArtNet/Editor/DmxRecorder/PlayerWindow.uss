.root {
    height: 100%;
}

TextField > Label {
    width: 75px;
    min-width: 75px;
}

Button > Image {
    width: 100%;
    height: 100%;
}

.error-message-area {
    background-color: var(--unity-colors-box-background);
    border-color: var(--unity-colors-default-border);
    border-width: 1px;
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 40px;
    padding: 3px;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(44, 44, 44);
    margin: 3px 0 0 0;
    padding: 0 6px;
}

.section-content {
    padding: 4px;
}

.section-content > VisualElement {
    flex-direction: row;
    justify-content: space-between;
}

#selectPlayFileButton {
    height: 18px;
    width: 24px;
    padding: 0;
}

#playTimeLabel {
    font-size: 11px;
    width: 50px;
    margin-top: 8px;
}

#playProgressBar {
    height: 15px;
    margin: 0 6px 0 6px;
}

#senderConfigFields Label {
    width: 150px;
    min-width: 150px;
}
