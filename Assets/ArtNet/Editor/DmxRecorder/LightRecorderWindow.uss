.Panel {
    border-color: #888888;
}

/* recorders panel */

#recordersPanel {
    background-color: #888888;
}

.RecorderListHeader {
    background-color: #DEDEDE;
    border-color: #606060;
}

#recorderList {
    background-color: #DEDEDE;
}

RecorderItem {
    background-color: #D4D4D4;
    border-color: #949494;
}

RecorderItem.selected {
    background-color: #E3E3E3;
    border-color: #A2A2A2;
}

#recorderList:focus > * > RecorderItem.selected {
    background-color: #C6C6C6;
    border-color: #4097C3;
}

RecorderItem.disabled {
    background-color: #A0A0A0;
}

RecorderItem.disabled.selected {
    background-color: #808080;
}

RecorderItem.selected > EditableLabel > * {
    color: #000000;
}

/* footer */

#footer {
    background-color: #A2A2A2;
}
